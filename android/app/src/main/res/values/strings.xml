         display name. Changing either makes Android treat this as a different
         app: the installed copy could not be updated and all local data would
         be lost. Display name only above. -->
    <string name="package_name">com.ragulkumar.lifehub</string>
    <string name="custom_url_scheme">com.ragulkumar.lifehub</string>
</resources>
